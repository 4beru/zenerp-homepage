# Variables de entorno — Zen ERP
# Copiá este archivo a `.env.local` para desarrollo local.
# En producción: Vercel → Settings → Environment Variables.

# --- Formulario de contacto (Resend, https://resend.com) ---
# API key de Resend (recomendado: una dedicada al proyecto, no la personal).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email donde llegan los leads. Decisión recomendada: usar una casilla
# dedicada del dominio (ej. contacto@zenerp.com) en vez de una personal:
# se puede compartir, reenviar y delegar sin exponer mails privados.
RESEND_TO_EMAIL=contacto@zenerp.com

# Remitente técnico: debe ser un dominio verificado en Resend.
# Sugerencia: "Zen ERP <leads@zenerp.com>" o solo el email.
RESEND_FROM_EMAIL=leads@zenerp.com
