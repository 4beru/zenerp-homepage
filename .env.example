# Environment variables example
DATABASE_URL="file:./db/custom.db"

# Asset pesado del Hero (video) — NO es un secreto: es la URL pública del
# CDN (Cloudflare R2 detrás de Cloudflare). Opcional: si no se define,
# production usa https://cdn.aberu.site y development el archivo local de
# public/video/. Ver src/lib/assets.ts.
# NEXT_PUBLIC_ASSET_CDN_URL="https://cdn.aberu.site"
