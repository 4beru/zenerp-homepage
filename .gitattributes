# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit binary files to prevent corruption across operating systems
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
